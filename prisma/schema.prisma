// Prisma schema configured for MongoDB
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  name      String?
  username  String?
  avatarUrl String?
  role      String    @default("collector")
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ref            String   @unique
  clientName     String
  clientEmail    String
  clientAvatar   String?
  clientUsername String?
  tattooTitle    String
  tattooImage    String
  style          String
  placement      String
  size           String
  date           String
  time           String
  sessionType    String   @default("Studio Appointment")
  depositPaid    Float    @default(50)
  estimatedTotal Float    @default(280)
  status         String   @default("deposit_held")
  notes          String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?  @db.ObjectId
}

model Tattoo {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  imageUrl       String
  style          String
  placement      String
  authorName     String
  authorUsername String
  authorAvatar   String?
  likesCount     Int      @default(0)
  savesCount     Int      @default(0)
  tags           String[]
  aspectRatio    String   @default("tall")
  description    String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}
